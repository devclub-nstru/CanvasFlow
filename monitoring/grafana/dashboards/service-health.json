{
  "uid": "canvasflow-service-health",
  "title": "CanvasFlow \u00b7 Service health",
  "description": "Rate, errors and duration for the API, plus the product failures that are otherwise invisible: submissions, mail and rate limiting.",
  "tags": ["canvasflow", "reliability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "5xx rate",
      "datasource": {
        "type": "prometheus",
        "uid": "canvasflow-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "canvasflow-prometheus"
          },
          "expr": "100 * (sum(rate(http_requests_total{status_class=\"5xx\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_requests_total[5m])), 0.001)",
          "legendFormat": ""
        }
      ],
      "description": "Share of responses in this class. `or vector(0)` matters: without it the panel reads \"No data\" when there are no errors at all, which is the moment you are most likely to be looking at it and the reading you would most misinterpret."
    },
    {
      "type": "stat",
      "title": "4xx rate",
      "datasource": {
        "type": "prometheus",
        "uid": "canvasflow-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "canvasflow-prometheus"
          },
          "expr": "100 * (sum(rate(http_requests_total{status_class=\"4xx\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_requests_total[5m])), 0.001)",
          "legendFormat": ""
        }
      ],
      "description": "Share of responses in this class. `or vector(0)` matters: without it the panel reads \"No data\" when there are no errors at all, which is the moment you are most likely to be looking at it and the reading you would most misinterpret."
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "canvasflow-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "canvasflow-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": ""
        }
      ]
    },
    {
      "type": "stat",
      "title": "p50 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "canvasflow-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "canvasflow-prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": ""
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate by route",
      "datasource": {
        "type": "prometheus",
        "uid": "canvasflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "canvasflow-prometheus"
          },
          "expr": "sum by (route) (rate(http_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ],
      "description": "Route is a template, never a raw path \u2014 see packages/observability/route.ts."
    },
    {
      "type": "timeseries",
      "title": "Responses by status class",
      "datasource": {
        "type": "prometheus",
        "uid": "canvasflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "canvasflow-prometheus"
          },
          "expr": "sum by (status_class) (rate(http_requests_total[5m]))",
          "legendFormat": "{{status_class}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency percentiles",
      "datasource": {
        "type": "prometheus",
        "uid": "canvasflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "canvasflow-prometheus"
          },
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "canvasflow-prometheus"
          },
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "canvasflow-prometheus"
          },
          "legendFormat": "p99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Slowest routes (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "canvasflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "canvasflow-prometheus"
          },
          "expr": "topk(5, histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m]))))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Form submissions",
      "datasource": {
        "type": "prometheus",
        "uid": "canvasflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "canvasflow-prometheus"
          },
          "expr": "sum by (result, reason) (rate(canvasflow_form_submissions_total[5m]))",
          "legendFormat": "{{result}} \u00b7 {{reason}}"
        }
      ],
      "description": "A rejected submission is a respondent who filled in a form and lost it. There is no second chance \u2014 the answers went with the page."
    },
    {
      "type": "timeseries",
      "title": "Mail dispatch",
      "datasource": {
        "type": "prometheus",
        "uid": "canvasflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "canvasflow-prometheus"
          },
          "expr": "sum by (template, result) (increase(canvasflow_mail_total[15m]))",
          "legendFormat": "{{template}} \u00b7 {{result}}"
        }
      ],
      "description": "result=failed means the relay rejected or was unreachable. result=logged means no relay is configured at all and the body went to stdout \u2014 in production nobody received it."
    },
    {
      "type": "timeseries",
      "title": "Rate-limit rejections by bucket",
      "datasource": {
        "type": "prometheus",
        "uid": "canvasflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "canvasflow-prometheus"
          },
          "expr": "sum by (bucket) (rate(canvasflow_rate_limit_rejections_total[5m]))",
          "legendFormat": "{{bucket}}"
        }
      ],
      "description": "A spike is either abuse or a limit set too tight. The bucket name is what tells the two apart."
    },
    {
      "type": "timeseries",
      "title": "Limiter fell back to per-process",
      "datasource": {
        "type": "prometheus",
        "uid": "canvasflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "canvasflow-prometheus"
          },
          "expr": "sum by (bucket) (rate(canvasflow_rate_limit_fallback_total[5m]))",
          "legendFormat": "{{bucket}}"
        }
      ],
      "description": "Non-zero means Redis is unreachable and every budget is silently multiplied by the number of API processes."
    }
  ]
}
