{
  "name": "trpc-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm db:up && dotenv -- turbo dev",
    "dev:no-db": "dotenv -- turbo dev",
    "build": "dotenv -- turbo build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types && tsc -p tsconfig.tests.json --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "pnpm test:infra:up && vitest run --config vitest.integration.config.ts",
    "test:integration:only": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:infra:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:infra:down": "docker compose -f docker-compose.test.yml down -v",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && pnpm db:up && pnpm db:migrate",
    "db:logs": "docker compose logs -f",
    "db:psql": "docker compose exec postgres psql -U \"${POSTGRES_USER:-postgres}\" -d \"${POSTGRES_DB:-dev}\"",
    "db:generate": "dotenv -- turbo db:generate",
    "db:migrate": "dotenv -- turbo db:migrate",
    "monitor:up": "docker compose -f docker-compose.monitoring.local.yml up -d",
    "monitor:down": "docker compose -f docker-compose.monitoring.local.yml down",
    "monitor:logs": "docker compose -f docker-compose.monitoring.local.yml logs -f",
    "monitor:targets": "curl -s 'http://localhost:9090/api/v1/targets?state=active' | node -e \"let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{for(const t of JSON.parse(s).data.activeTargets)console.log(t.health==='up'?'  up  ':'  DOWN',t.labels.job,t.scrapeUrl,t.lastError||'')})\""
  },
  "pnpm": {
    "overrides": {
      "zod": "4.4.3"
    }
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22",
    "@types/pg": "^8.16.0",
    "@vitest/coverage-v8": "^3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "jsdom": "^30.0.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.2",
    "pg": "^8.16.3",
    "prettier": "^3.7.4",
    "turbo": "^2.7.2",
    "typescript": "5.9.2",
    "vitest": "^3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
