# API Server
PORT=8000
NODE_ENV=development
BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/dev
POSTGRES_PORT=5434
DB_POOL_MAX=25
DB_STATEMENT_TIMEOUT_MS=10000

# Clustering
CLUSTER_WORKERS=0

# Rate Limiting
RATE_LIMIT_PUBLIC_WRITE_MAX=60
RATE_LIMIT_AUTH_MAX=300
RATE_LIMIT_UPLOAD_MAX=30
# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_PREFIX=cf

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=canvasflow

# File Uploads
# The API parks incoming files here and the worker reads them back before
# shipping to Cloudinary, so both processes must resolve this to the SAME
# directory. Under Docker that means a shared volume (docker-compose.prod.yml
# already wires one up and overrides this value).
UPLOAD_TMP_DIR=
UPLOAD_MAX_MB=10
UPLOAD_MAX_MB_IMAGE=10
UPLOAD_MAX_MB_VIDEO=100
UPLOAD_MAX_MB_RAW=10
UPLOAD_WORKER_CONCURRENCY=8

# Sessions
# Every session token is signed with this value. Generate one with
# `openssl rand -base64 32`. The API refuses to start in production when it is
# unset; in development it falls back to a well-known insecure string and warns
# loudly. BETTER_AUTH_SECRET is still read as an alias so existing deployments
# keep working, but JWT_SECRET wins when both are present.
JWT_SECRET=replace-me-with-an-openssl-rand-base64-32-value
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8000
WEB_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Web App
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URLS=http://localhost:8080,http://localhost:8000

# Menti — the live presentation service (apps/menti). Leave blank to disable
# the feature in the web app.
NEXT_PUBLIC_MENTI_API_URL=http://localhost:8080

# Menti (apps/menti)
# MENTI_PORT, not PORT: PORT is already claimed by apps/api in this same file,
# and setup.sh hard-links this file into every workspace.
MENTI_PORT=8080
MONGO_URI=mongodb://menti:menti@localhost:27017/menti?authSource=admin
MONGO_USER=menti
MONGO_PASSWORD=menti
MONGO_DB=menti
MONGO_PORT=27017
# Extra browser origins allowed to reach menti over HTTP and websockets.
MENTI_TRUSTED_ORIGINS=
# debug | info | warn | error | silent. Defaults to debug in dev, info in prod.
# "debug" also enables the event-loop monitor, which is what you want when
# profiling a large room.
MENTI_LOG_LEVEL=

# Production Split / CORS
TRUSTED_ORIGINS=
COOKIE_DOMAIN=
SKIP_ENV_VALIDATION=


RATE_LIMIT_LOGIN_IP_MAX=12
RATE_LIMIT_LOGIN_ACCOUNT_MAX=8
RATE_LIMIT_AUTH_ROUTE_MAX=240

# Hard ceiling on participants in one Menti session, enforced at join time.
# The join-route rate limiter bounds how fast they arrive; this bounds how many
# arrive at all. Remember that every state frame is serialised to this many
# sockets, so raise it deliberately.
MENTI_MAX_PARTICIPANTS_PER_SESSION=2000
