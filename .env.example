# ============================================================================
# CanvasFlow — environment template
#
#   cp .env.example .env     (or run ./setup.sh, which also hard-links this
#                             file into every app and package directory)
#
# Every variable below is read by first-party code or by the compose files.
# Anything with a value shown is the default the code already applies, so it
# can be left commented or blank unless you want to change it. Anything blank
# with "REQUIRED" against it must be filled in before that part of the stack
# will run.
#
# Layout: shared -> per-service -> infrastructure -> tunables.
# ============================================================================


# ── Core ────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Public origin of each half of the stack. These are not cosmetic:
# BASE_URL builds the OAuth callback and email-confirmation links, and WEB_URL
# builds the password-reset link. An unset WEB_URL in production puts localhost
# URLs in real emails, so the API logs an error when that happens.
BASE_URL=http://localhost:8000
WEB_URL=http://localhost:3000

# The API's own listener. MENTI_PORT is separate — see the Menti section.
PORT=8000


# ── Secrets ─────────────────────────────────────────────────────────────────

# REQUIRED. Signs every session token. The API refuses to boot in production
# without it rather than accept forgeable tokens.
#   openssl rand -base64 32
JWT_SECRET=

# Legacy alias for JWT_SECRET, still read as a fallback so sessions minted
# before the rename keep working. JWT_SECRET wins when both are set. Safe to
# leave empty on a new deployment.
BETTER_AUTH_SECRET=


# ── OAuth providers ─────────────────────────────────────────────────────────
#
# Optional. Each pair enables one social button; with neither pair set, only
# email and password sign-in is offered.
#
# Authorised redirect URI to register with the provider:
#   <BASE_URL>/api/auth/callback/google
#   <BASE_URL>/api/auth/callback/github

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# ── Outbound email (SMTP) ──────────────────────────────────────────────────
#
# Required for password reset and address confirmation to reach real users.
# With no relay configured both flows still work end to end, but the message is
# written to the log instead of being sent — fine locally, and the API logs an
# error in production so it is never silent.
#
# Either set SMTP_URL on its own:
#   smtp://user:pass@smtp.example.com:587      STARTTLS
#   smtps://user:pass@smtp.example.com:465     implicit TLS
# (percent-encode any @ : or / in the password), or use the discrete fields
# below, which avoid the escaping entirely.
#
# Port 25 is not an option on EC2 — AWS blocks it outbound by default, and mail
# from an EC2 address is distrusted regardless. 587 and 465 to somebody else's
# relay are unaffected.
#
# Known-good relays:
#   Amazon SES   email-smtp.<region>.amazonaws.com:587  — credentials are
#                generated in the SES console and are NOT your AWS access keys.
#                Requires leaving the SES sandbox before you can mail an
#                unverified address.
#   Brevo / Mailgun / Postmark   provider's host on 587.
#   Gmail        smtp.gmail.com:465 with an app password (2FA required). Capped
#                around 500/day; fine for a demo, not for product mail.
#
# To watch a real message locally without an account anywhere, run Mailpit and
# point at it — it accepts anything and shows the mail at http://localhost:8025:
#   docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
#   SMTP_HOST=localhost
#   SMTP_PORT=1025

SMTP_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Leave blank to derive from the port (465 = implicit TLS, anything else =
# STARTTLS). Only set it when a relay does something non-standard.
SMTP_SECURE=

# The From address. There is no vendor sandbox to fall back on: unset, the
# authenticating SMTP username is used when it is itself an address, and the
# API reports the problem at boot when it is not.
#
# It must be at a domain the relay is allowed to send for — one whose DNS
# publishes the relay's DKIM and SPF records. A personal mailbox domain
# (gmail.com and friends) only works when relaying through that same provider's
# own server, which the API checks for and stays quiet about.

MAIL_FROM=


# ── Postgres ────────────────────────────────────────────────────────────────

# REQUIRED. The forms side of the product lives here.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/dev

# Per-process pool size. Multiply by CLUSTER_WORKERS to get the real
# connection budget — the API warns at boot when that exceeds Postgres's
# default max_connections of 100.
DB_POOL_MAX=25

# Kills a query that runs longer than this, so one pathological statement
# cannot hold a connection open indefinitely.
DB_STATEMENT_TIMEOUT_MS=15000


# ── Redis ───────────────────────────────────────────────────────────────────

# REQUIRED by Menti, and strongly recommended for the API: without it the rate
# limiters fall back to per-process counters, which multiplies every budget by
# the number of processes.
REDIS_URL=redis://localhost:6379

# Namespaces every key, so one Redis instance can serve the API's cache, the
# BullMQ queues and Menti's presence sets without collision.
REDIS_PREFIX=cf


# ── Menti (live presentations) ──────────────────────────────────────────────

# REQUIRED for Menti. Sessions, slides, participants and responses live here.
MONGO_URI=mongodb://menti:menti@localhost:27017/menti?authSource=admin

# MENTI_PORT, not PORT: PORT is already claimed by the API in this same file,
# and both services read this one env file.
MENTI_PORT=8080

# Comma-separated extra browser origins allowed to open a socket, beyond
# WEB_URL. Localhost is added automatically outside production.
MENTI_TRUSTED_ORIGINS=

# debug | info | warn | error | silent. Defaults to debug in dev, info in prod.
# "debug" also enables the event-loop monitor, which is what you want when
# profiling a large room.
MENTI_LOG_LEVEL=

# Set to 1 to force the event-loop delay histogram on without turning the
# whole log level up.
MENTI_EVENT_LOOP_MONITOR=

# Hard ceiling on participants in one session, enforced at join time. The
# join-route rate limiter bounds how fast they arrive; this bounds how many
# arrive at all. Every state frame is serialised to this many sockets, so
# raise it deliberately.
MENTI_MAX_PARTICIPANTS_PER_SESSION=2000

# Mongo connection pool. 200 is generous because a large room opens a burst of
# reads on join.
MONGO_POOL_MAX=200
MONGO_POOL_MIN=0


# ── Object storage (PowerPoint imports and rendered slides) ─────────────────
#
# Cloudflare R2 by default. The S3_* names are accepted as aliases for any
# other S3-compatible provider — set S3_ENDPOINT and the S3_* keys instead of
# R2_ACCOUNT_ID. Leave all of it blank to keep uploads on local disk.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# Only needed for a non-R2 S3-compatible endpoint.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_DOMAIN=


# ── PowerPoint conversion binaries ──────────────────────────────────────────
#
# The import pipeline shells out to LibreOffice and poppler. Both are looked up
# on PATH; set these only when they live somewhere non-standard.

SOFFICE_PATH=
PDFTOPPM_PATH=


# ── Cloudinary (form file uploads) ──────────────────────────────────────────
#
# Used by the upload worker. Leave blank and the API returns an honest 503 for
# file-upload fields rather than accepting files it cannot store.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=canvasflow


# ── Uploads ─────────────────────────────────────────────────────────────────

# Where the API parks a file before the worker ships it. In compose this is a
# volume both containers mount, so they must agree on the path.
UPLOAD_TMP_DIR=

# Size ceilings in MB. UPLOAD_MAX_MB is the multer-level cap; the per-type
# limits are enforced after the MIME type is known.
UPLOAD_MAX_MB=10
UPLOAD_MAX_MB_IMAGE=10
UPLOAD_MAX_MB_VIDEO=100
UPLOAD_MAX_MB_RAW=10

# How many uploads the worker ships concurrently.
UPLOAD_WORKER_CONCURRENCY=8


# ── Rate limits ─────────────────────────────────────────────────────────────
#
# Requests per minute. All are leaky buckets, so a burst of capacity+1 is
# admitted before throttling begins.

# Public form and feedback submissions, per client.
RATE_LIMIT_PUBLIC_WRITE_MAX=60

# Everything under /trpc and /api, per client, with an always-on per-IP floor
# five times as loose so a rotated cookie cannot buy a fresh budget.
RATE_LIMIT_AUTH_MAX=300

# File uploads.
RATE_LIMIT_UPLOAD_MAX=30

# Credential endpoints. LOGIN_IP bounds one machine; LOGIN_ACCOUNT bounds
# guesses against a single account however many addresses they come from,
# which is what protects a targeted user from a distributed attempt.
RATE_LIMIT_LOGIN_IP_MAX=12
RATE_LIMIT_LOGIN_ACCOUNT_MAX=8

# The rest of /api/auth — get-session and the OAuth dance. Raise it if real
# users behind a shared NAT start seeing 429s.
RATE_LIMIT_AUTH_ROUTE_MAX=240

# Endpoints that send email. Tighter than the credential limits because each
# request costs money and can be aimed at an inbox the caller does not own.
RATE_LIMIT_EMAIL_IP_MAX=5
RATE_LIMIT_EMAIL_ACCOUNT_MAX=3


# ── Web app (browser-visible) ───────────────────────────────────────────────
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time. Never
# put a secret in one.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MENTI_API_URL=http://localhost:8080

# Comma-separated extra API origins to allow in the Content-Security-Policy,
# for a staging API alongside production.
NEXT_PUBLIC_API_URLS=


# ── Cross-origin / cookies ──────────────────────────────────────────────────

# Comma-separated origins allowed to make credentialed requests to the API,
# beyond the built-in list. Also the allow-list for post-login redirects.
TRUSTED_ORIGINS=

# Set to a parent domain (".example.com") to share the session cookie across
# subdomains. Leave blank for host-only cookies.
COOKIE_DOMAIN=


# ── Process management ──────────────────────────────────────────────────────

# API worker processes. 0 means single-process; anything higher forks that many
# and multiplies the Postgres connection budget with it.
CLUSTER_WORKERS=0

# error | debug | info.
LOGGER_LEVEL=


# ── Local infrastructure (docker compose) ───────────────────────────────────
#
# Read by docker-compose.yml and docker-compose.prod.yml, not by application
# code. Host ports for the dev stack, and credentials for the prod stack.

POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=canvasflow

REDIS_PORT=6379
# REQUIRED in production: docker-compose.prod.yml starts Redis with
# --requirepass and its healthcheck authenticates with this.
REDIS_PASSWORD=

MONGO_PORT=27017
MONGO_USER=menti
MONGO_PASSWORD=menti
MONGO_DB=menti


# ── Public edge ────────────────────────────────────────────────────────────
#
# Nothing here: TLS and routing are nginx's job on the host, outside compose.
# The app containers publish on 127.0.0.1 (3000 web, 8000 api, 8080 menti) for
# nginx to proxy to. The public origins they must be served at are BASE_URL,
# WEB_URL and the two NEXT_PUBLIC_* values above.


# ── Build / tooling ─────────────────────────────────────────────────────────

# Skips env validation so a build can run without runtime secrets. CI sets it.
SKIP_ENV_VALIDATION=

# Only read by the load-testing tools in apps/menti/tools. They default to
# localhost, so these are for pointing a run at a deployed environment.
MENTI_URL=
TARGET_URL=
API_URL=
